
---

## 📁 New File: `.env.example`

```env
# ============================================================
# Slotopol Server Environment Variables
# ============================================================

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change_this_password
DB_NAME=slotopol
MYSQL_ROOT_PASSWORD=change_root_password

# Database Port (for Docker)
DB_PORT_EXTERNAL=3306

# JWT Keys (Generate your own)
ACCESS_KEY=generate_your_own_secure_key_here
REFRESH_KEY=generate_your_own_secure_key_here

# Token Expiry
ACCESS_TTL=24h
REFRESH_TTL=72h

# Cloudinary Configuration - REQUIRED
CLOUDINARY_CLOUD_NAME=your_cloud_name_from_cloudinary_dashboard
CLOUDINARY_API_KEY=your_api_key_from_cloudinary_dashboard
CLOUDINARY_API_SECRET=your_api_secret_from_cloudinary_dashboard
CLOUDINARY_UPLOAD_FOLDER=slotopol

# Server Port
SERVER_PORT=8080

# Brevo Email (Optional)
BREVO_API_KEY=your_brevo_api_key_optional
