# ============================================================
# Slotopol Server Environment Variables
# ============================================================

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_secure_password_here
DB_NAME=slotopol
MYSQL_ROOT_PASSWORD=your_root_password_here

# Database Port (for Docker)
DB_PORT_EXTERNAL=3306

# JWT Keys (Generate your own)
ACCESS_KEY=your_access_key_here_please_change_this
REFRESH_KEY=your_refresh_key_here_please_change_this

# Token Expiry
ACCESS_TTL=24h
REFRESH_TTL=72h

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=slotopol

# Server Port
SERVER_PORT=8080
