# ============================================================
# Slotopol Server Environment Variables
# ============================================================

# Database Configuration
SLOTOPOL_DBDRIVER=mysql
SLOTOPOL_DB_USER=admin
SLOTOPOL_DB_PASSWORD=your_secure_password_here
SLOTOPOL_DB_NAME=slotopol
SLOTOPOL_DB_PORT=3306
SLOTOPOL_CLUBDSN=${SLOTOPOL_DB_USER}:${SLOTOPOL_DB_PASSWORD}@tcp(database:${SLOTOPOL_DB_PORT})/${SLOTOPOL_DB_NAME}
SLOTOPOL_SPINDSN=${SLOTOPOL_DB_USER}:${SLOTOPOL_DB_PASSWORD}@tcp(database:${SLOTOPOL_DB_PORT})/${SLOTOPOL_DB_NAME}

# MySQL Root Password
MYSQL_ROOT_PASSWORD=rootpassword

# JWT Keys (Generate your own!)
SLOTOPOL_ACCESS_KEY=your_access_key_here_please_change_this
SLOTOPOL_REFRESH_KEY=your_refresh_key_here_please_change_this

# Server Port
SLOTOPOL_PORT=8080

# Cloudinary Configuration (Required for image uploads)
SLOTOPOL_CLOUDINARY_CLOUD_NAME=your_cloud_name
SLOTOPOL_CLOUDINARY_API_KEY=your_api_key
SLOTOPOL_CLOUDINARY_API_SECRET=your_api_secret
SLOTOPOL_CLOUDINARY_UPLOAD_FOLDER=slotopol

# Brevo Email (Optional)
SLOTOPOL_BREVO_API_KEY=your_brevo_api_key_optional
