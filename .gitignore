# ============================================================
# Slotopol Server - .gitignore
# ============================================================

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
slotopol-server
slot_*
slot-debug

# Test binary
*.test

# Coverage
*.out

# Environment variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Database files
*.sqlite
*.sqlite3
*.db

# Uploads directory (local file storage)
uploads/
cloudinary-sync/

# Temporary development files
reeldev.yaml
TODO
*.tmp
*.log
logs/

# Docker files (ignore local docker-compose overrides)
docker-compose.override.yml
*.pid

# Go workspace
go.work
go.work.sum

# Vendor (if used)
vendor/

# Build output
dist/
bin/
out/
